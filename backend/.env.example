# Banco de dados (produção: string de conexão do Postgres real)
DATABASE_URL="postgresql://usuario:senha@host:5432/nome_do_banco"

# Porta que o backend vai escutar
PORT=3000

# Chave secreta do JWT — gere uma bem longa e aleatória em produção
# (ex: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=967d4c65a6a128ab4ce29d839accbb355706daadbe6f6606d99076f1503fa26bce8760be1815705a9f2de63495ca64971ef492aaacaa2bf44338c440b09c0915

# URL(s) do frontend publicado, separadas por vírgula se houver mais de uma.
# Sem isso, a API só aceita localhost (bloqueia o site publicado!).
FRONTEND_URL=https://app.suaempresa.com

# SMTP para o "esqueci minha senha" enviar e-mail de verdade.
# Sem isso, o link de reset só aparece no console do servidor.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
